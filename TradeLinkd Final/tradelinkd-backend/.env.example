# Required
JWT_SECRET=replace_this_with_a_long_random_string

# Server
PORT=3001
# Comma-separated list of origins allowed to call this API (e.g. your deployed
# frontend URL). Leave unset in development to allow all origins.
CORS_ORIGIN=
# Public URL of this deployment, used in emails (password reset links, etc.)
APP_URL=http://localhost:3001

# Where to store the SQLite database and uploaded files. On Railway, point
# this at a mounted volume (e.g. /data) so data survives redeploys.
DATA_DIR=

# Optional: token lifetime (defaults to 7d if unset)
JWT_EXPIRES_IN=7d

# Optional: outgoing email (password reset). Without these, reset requests
# "succeed" silently but no email is sent - see README.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Stripe billing (currently dormant, not linked from the UI)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
